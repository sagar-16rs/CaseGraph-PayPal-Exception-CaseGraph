# Local development configuration
DATABASE_URL=sqlite:///./.data/casegraph.db
CASEGRAPH_ENV=development
CASEGRAPH_AUTH_MODE=disabled

# PayPal sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_VERIFY=true
PAYPAL_TIMEOUT_SECONDS=30
PAYPAL_MULTIPART_TIMEOUT_SECONDS=60

# PayPal transport: `live` calls PAYPAL_BASE_URL; `simulated` uses the bundled
# deterministic sandbox so the product can be demonstrated without a PayPal
# developer account. Simulated is refused when CASEGRAPH_ENV=production.
CASEGRAPH_PAYPAL_TRANSPORT=simulated
CASEGRAPH_SIMULATION_STATE=.data/simulated-paypal.json
# none | timeout | server_error — injects a fault into simulated writes so the
# UNKNOWN_OUTCOME -> reconciliation path can be demonstrated.
CASEGRAPH_SIMULATED_FAULT=none

# OpenAI / OpenAI-compatible LLM (e.g. DeepSeek)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6
# auto | openai | deepseek | rules. `auto` prefers OpenAI/DeepSeek when a key is
# set and otherwise falls back to the deterministic reference reasoner outside production.
CASEGRAPH_AI_PROVIDER=auto
# auto | responses | chat_completions. `auto` uses `/v1/responses` for OpenAI and
# automatically switches to `/v1/chat/completions` for DeepSeek or compatible gateways.
CASEGRAPH_AI_API_MODE=auto
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_BUNDLE_CHARS=200000

# Durable worker
CASEGRAPH_WORKER_LEASE_SECONDS=60
CASEGRAPH_WORKER_MAX_ATTEMPTS=8
CASEGRAPH_WORKER_POLL_SECONDS=2
CASEGRAPH_WORKER_BACKOFF_BASE_SECONDS=5
CASEGRAPH_WORKER_BACKOFF_CAP_SECONDS=300
CASEGRAPH_DISPUTE_LOCK_TIMEOUT_SECONDS=30

# Local upload behavior
CASEGRAPH_UPLOAD_DIR=.data/evidence_files
CASEGRAPH_UPLOAD_MAX_FILE_BYTES=9000000
CASEGRAPH_UPLOAD_SCANNER=none
CASEGRAPH_UPLOAD_ALLOW_UNSCANNED_DEV=true
