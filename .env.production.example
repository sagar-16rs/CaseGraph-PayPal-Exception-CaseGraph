# Runtime
CASEGRAPH_ENV=production
DATABASE_URL=postgresql+psycopg://casegraph:CHANGE_ME@postgres:5432/casegraph

# PayPal
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_WEBHOOK_ID=CHANGE_ME
PAYPAL_WEBHOOK_VERIFY=true

# OpenAI
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=CHANGE_ME

# Authentication / tenant
CASEGRAPH_AUTH_MODE=enforce
CASEGRAPH_TENANT_ID=merchant-demo
CASEGRAPH_AUTH_ISSUER=https://identity.example.com
CASEGRAPH_AUTH_AUDIENCE=casegraph-api
CASEGRAPH_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
CASEGRAPH_AUTH_ROLES_CLAIM=roles
CASEGRAPH_AUTH_TENANT_CLAIM=tenant_id
CASEGRAPH_ENFORCE_ROLE_SEPARATION=true

# Browser security
CASEGRAPH_ALLOWED_ORIGINS=https://casegraph.example.com
CASEGRAPH_MAX_JSON_REQUEST_BYTES=1000000
CASEGRAPH_MAX_UPLOAD_REQUEST_BYTES=10500000

# Rate limiting
CASEGRAPH_RATE_LIMIT_BACKEND=redis
CASEGRAPH_REDIS_URL=redis://casegraph:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# Evidence files
CASEGRAPH_UPLOAD_DIR=.data/evidence_files
CASEGRAPH_UPLOAD_MAX_FILE_BYTES=9000000
CASEGRAPH_UPLOAD_SCANNER=clamav
CASEGRAPH_UPLOAD_ALLOW_UNSCANNED_DEV=false
CASEGRAPH_CLAMAV_MAX_DB_AGE_HOURS=72

# Observability
CASEGRAPH_OTEL_ENABLED=true
CASEGRAPH_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces

# Proxy configuration
FORWARDED_ALLOW_IPS=127.0.0.1

# Container database bootstrap
POSTGRES_DB=casegraph
POSTGRES_USER=casegraph
POSTGRES_PASSWORD=CHANGE_ME

# Pin a collector image before production deployment
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector:CHANGE_ME
